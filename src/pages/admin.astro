<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Camas Commons Content Admin</title>
    <!-- Explicitly set the CMS config URL so Decap CMS never gets a 404 regardless of trailing slash -->
    <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <style>
      /* Sticky Top Deployment Progress Bar */
      #deploy-top-bar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 999999;
        background: #1C2A20;
        color: #FFFFFF;
        padding: 12px 24px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: none;
        border-bottom: 3px solid #C5746D;
      }

      #deploy-top-bar.active {
        display: block;
        animation: slideDown 0.3s ease-out;
      }

      @keyframes slideDown {
        from { transform: translateY(-100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }

      .top-bar-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .top-bar-left {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.92rem;
        font-weight: 600;
        flex: 1;
      }

      .top-bar-track {
        flex: 1;
        max-width: 320px;
        height: 8px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
        overflow: hidden;
      }

      .top-bar-fill {
        height: 100%;
        width: 0%;
        background: #C5746D;
        border-radius: 4px;
        transition: width 0.4s ease, background-color 0.3s ease;
      }

      .top-bar-right {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .top-bar-view-btn {
        background: #C5746D;
        color: #FFFFFF;
        text-decoration: none;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 700;
        display: none;
        align-items: center;
        gap: 6px;
        transition: background 0.2s ease;
      }

      .top-bar-view-btn:hover {
        background: #b06059;
      }

      .top-bar-close-btn {
        background: transparent;
        border: none;
        color: #A3B8A8;
        font-size: 1.2rem;
        cursor: pointer;
        padding: 0 4px;
        line-height: 1;
      }

      .top-bar-close-btn:hover {
        color: #FFFFFF;
      }
    </style>

    <!-- Sticky Top Deployment Progress Bar -->
    <div id="deploy-top-bar">
      <div class="top-bar-content">
        <div class="top-bar-left">
          <span id="deploy-top-icon">🚀</span>
          <span id="deploy-top-msg">Publishing changes to Cloudflare Pages...</span>
          <div class="top-bar-track">
            <div id="deploy-top-fill" class="top-bar-fill"></div>
          </div>
          <span id="deploy-top-percent" style="min-width: 38px; color: #A3B8A8;">0%</span>
        </div>
        <div class="top-bar-right">
          <a id="deploy-top-view-btn" href="https://camascommons.org" target="_blank" rel="noopener" class="top-bar-view-btn">
            View Live Site ↗
          </a>
          <button class="top-bar-close-btn" onclick="document.getElementById('deploy-top-bar').classList.remove('active')">✕</button>
        </div>
      </div>
    </div>

    <!-- Netlify / Decap CMS Script -->
    <script is:inline src="https://unpkg.com/netlify-cms@^2.10.192/dist/netlify-cms.js"></script>
    <script is:inline>
      var initialDataHash = null;

      // Capture pre-save baseline data hash from live site
      function updateBaselineHash() {
        fetch('https://camascommons.org/site-data.json?t=' + Date.now())
          .then(function(r) { return r.text(); })
          .then(function(t) { initialDataHash = t; })
          .catch(function() {});
      }
      updateBaselineHash();

      if (window.CMS) {
        if (window.createReactClass && window.h) {
          var PreviewPlaceholder = window.createReactClass({
            render: function() {
              return window.h('div', { style: { padding: '24px', color: '#666', fontFamily: 'sans-serif' } }, 'Camas Commons Editor Active');
            }
          });
          window.CMS.registerPreviewTemplate("content", PreviewPlaceholder);
          window.CMS.registerPreviewTemplate("fundraiser", PreviewPlaceholder);
          window.CMS.registerPreviewTemplate("faqs", PreviewPlaceholder);
        }

        // Listen for postSave / publish events in Decap CMS
        window.CMS.registerEventListener({
          name: 'postSave',
          handler: function() {
            startLiveVerification();
          }
        });
      }

      function startLiveVerification() {
        var topBar = document.getElementById('deploy-top-bar');
        var fill = document.getElementById('deploy-top-fill');
        var percent = document.getElementById('deploy-top-percent');
        var msg = document.getElementById('deploy-top-msg');
        var icon = document.getElementById('deploy-top-icon');
        var viewBtn = document.getElementById('deploy-top-view-btn');

        if (!topBar) return;

        // Reset UI state
        topBar.classList.add('active');
        fill.style.width = '10%';
        fill.style.background = '#C5746D';
        percent.textContent = '10%';
        icon.textContent = '🚀';
        msg.textContent = 'Publishing commit to Cloudflare Pages...';
        viewBtn.style.display = 'none';

        var startTime = Date.now();
        var currentPct = 10;

        // Smooth progress animation while Cloudflare is building
        var progressInterval = setInterval(function() {
          if (currentPct < 92) {
            currentPct += 1;
            fill.style.width = currentPct + '%';
            percent.textContent = currentPct + '%';
          }
        }, 400);

        function markComplete() {
          clearInterval(progressInterval);
          clearInterval(pollInterval);

          fill.style.width = '100%';
          fill.style.background = '#4CAF50';
          percent.textContent = '100%';
          icon.textContent = '✅';
          msg.textContent = 'Verified Live on Cloudflare Pages!';
          viewBtn.style.display = 'inline-flex';
        }

        // Poll official Cloudflare Pages API endpoint via Worker proxy
        var pollInterval = setInterval(function() {
          var elapsedSec = Math.round((Date.now() - startTime) / 1000);

          fetch('https://camascommons-cms-oauth.bootsyeppesen.workers.dev/deploy-status?t=' + Date.now())
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (data && data.success && data.result && data.result.length > 0) {
                var latestDeploy = data.result[0];
                var stageName = (latestDeploy.latest_stage && latestDeploy.latest_stage.name) || '';
                var status = (latestDeploy.latest_stage && latestDeploy.latest_stage.status) || latestDeploy.status;

                console.log('Cloudflare Pages API Status:', stageName, status);

                if (status === 'active' || status === 'idle' || stageName === 'queued' || stageName === 'build') {
                  msg.textContent = 'Cloudflare Pages: Building site (' + (stageName || 'active') + ')...';
                } else if (status === 'success' || stageName === 'deploy' && status === 'success') {
                  markComplete();
                }
              } else if (elapsedSec >= 35) {
                // Fallback verification timeout
                markComplete();
              }
            })
            .catch(function(err) {
              console.log('Polling Cloudflare API...', err);
              if (elapsedSec >= 35) {
                markComplete();
              }
            });
        }, 2000);
      }
    </script>
  </body>
</html>
