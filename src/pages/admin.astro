<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Camas Commons Content Admin</title>
    <!-- Explicitly set the CMS config URL so Decap CMS never gets a 404 regardless of trailing slash -->
    <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <style>
      #deploy-banner {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 99999;
        background: #1C2A20;
        color: #FFFFFF;
        padding: 16px 20px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: none;
        width: 340px;
        border: 1px solid rgba(255, 255, 255, 0.15);
      }

      #deploy-banner.active {
        display: block;
        animation: slideUp 0.3s ease-out;
      }

      @keyframes slideUp {
        from { transform: translateY(100px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }

      .deploy-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 10px;
      }

      .deploy-title {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .deploy-progress-track {
        width: 100%;
        height: 8px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 10px;
      }

      .deploy-progress-fill {
        height: 100%;
        width: 0%;
        background: #C5746D;
        border-radius: 4px;
        transition: width 0.4s linear;
      }

      .deploy-status-text {
        font-size: 0.82rem;
        color: #A3B8A8;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .deploy-view-btn {
        background: #C5746D;
        color: #fff;
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 600;
        display: inline-block;
        margin-top: 8px;
        transition: background 0.2s ease;
      }

      .deploy-view-btn:hover {
        background: #b06059;
      }
    </style>

    <!-- Floating Live Deployment Banner -->
    <div id="deploy-banner">
      <div class="deploy-header">
        <div class="deploy-title">
          <span id="deploy-icon">🚀</span>
          <span id="deploy-title-text">Deploying to Cloudflare...</span>
        </div>
        <span id="deploy-percent">0%</span>
      </div>
      <div class="deploy-progress-track">
        <div id="deploy-progress-fill" class="deploy-progress-fill"></div>
      </div>
      <div class="deploy-status-text">
        <span id="deploy-msg">Building live site (~40s)...</span>
      </div>
      <div id="deploy-action" style="display: none; text-align: right;">
        <a href="https://camascommons.org" target="_blank" rel="noopener" class="deploy-view-btn">
          View Live Site ↗
        </a>
      </div>
    </div>

    <!-- Netlify / Decap CMS Script -->
    <script is:inline src="https://unpkg.com/netlify-cms@^2.10.192/dist/netlify-cms.js"></script>
    <script is:inline>
      if (window.CMS) {
        if (window.createReactClass && window.h) {
          var PreviewPlaceholder = window.createReactClass({
            render: function() {
              return window.h('div', { style: { padding: '24px', color: '#666', fontFamily: 'sans-serif' } }, 'Camas Commons Editor Active');
            }
          });
          window.CMS.registerPreviewTemplate("content", PreviewPlaceholder);
          window.CMS.registerPreviewTemplate("fundraiser", PreviewPlaceholder);
          window.CMS.registerPreviewTemplate("faqs", PreviewPlaceholder);
        }

        // Listen for postSave / publish events in Decap CMS
        window.CMS.registerEventListener({
          name: 'postSave',
          handler: function() {
            startDeploymentTimer();
          }
        });
      }

      function startDeploymentTimer() {
        var banner = document.getElementById('deploy-banner');
        var fill = document.getElementById('deploy-progress-fill');
        var percent = document.getElementById('deploy-percent');
        var titleText = document.getElementById('deploy-title-text');
        var msg = document.getElementById('deploy-msg');
        var icon = document.getElementById('deploy-icon');
        var action = document.getElementById('deploy-action');

        if (!banner) return;

        // Reset UI state
        banner.classList.add('active');
        fill.style.width = '0%';
        fill.style.background = '#C5746D';
        percent.textContent = '0%';
        icon.textContent = '🚀';
        titleText.textContent = 'Deploying Changes...';
        msg.textContent = 'Building on Cloudflare Pages (~40s)';
        action.style.display = 'none';

        var durationSec = 40;
        var elapsed = 0;
        var interval = setInterval(function() {
          elapsed += 1;
          var pct = Math.min(Math.round((elapsed / durationSec) * 100), 95);
          fill.style.width = pct + '%';
          percent.textContent = pct + '%';

          if (elapsed >= durationSec) {
            clearInterval(interval);
            fill.style.width = '100%';
            fill.style.background = '#4CAF50';
            percent.textContent = '100%';
            icon.textContent = '✅';
            titleText.textContent = 'Changes are Live!';
            msg.textContent = 'Published to camascommons.org';
            action.style.display = 'block';

            // Auto-hide banner after 15 seconds
            setTimeout(function() {
              banner.classList.remove('active');
            }, 15000);
          }
        }, 1000);
      }
    </script>
  </body>
</html>
