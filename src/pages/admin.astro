<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Camas Commons Content Admin</title>
    <!-- Explicitly set the CMS config URL so Decap CMS never gets a 404 regardless of trailing slash -->
    <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <style>
      /* Sticky Top Deployment Progress Bar */
      #deploy-top-bar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 999999;
        background: #1C2A20;
        color: #FFFFFF;
        padding: 12px 24px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: none;
        border-bottom: 3px solid #C5746D;
      }

      #deploy-top-bar.active {
        display: block;
        animation: slideDown 0.3s ease-out;
      }

      @keyframes slideDown {
        from { transform: translateY(-100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }

      .top-bar-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .top-bar-left {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.92rem;
        font-weight: 600;
        flex: 1;
      }

      .top-bar-track {
        flex: 1;
        max-width: 320px;
        height: 8px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
        overflow: hidden;
      }

      .top-bar-fill {
        height: 100%;
        width: 0%;
        background: #C5746D;
        border-radius: 4px;
        transition: width 0.4s ease, background-color 0.3s ease;
      }

      .top-bar-right {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .top-bar-view-btn {
        background: #C5746D;
        color: #FFFFFF;
        text-decoration: none;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 700;
        display: none;
        align-items: center;
        gap: 6px;
        transition: background 0.2s ease;
      }

      .top-bar-view-btn:hover {
        background: #b06059;
      }

      .top-bar-close-btn {
        background: transparent;
        border: none;
        color: #A3B8A8;
        font-size: 1.2rem;
        cursor: pointer;
        padding: 0 4px;
        line-height: 1;
      }

      /* Floating Analytics Button */
      #analytics-fab {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 99990;
        background: #24472F;
        color: #FFFFFF;
        border: 2px solid #E6DCCE;
        padding: 10px 20px;
        border-radius: 30px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(36, 71, 47, 0.35);
        transition: transform 0.2s ease, background-color 0.2s ease;
      }

      #analytics-fab:hover {
        transform: translateY(-2px);
        background: #193321;
      }

      /* Analytics Modal Styling */
      .analytics-backdrop {
        position: fixed;
        inset: 0;
        z-index: 999999;
        background: rgba(28, 42, 32, 0.75);
        backdrop-filter: blur(5px);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .analytics-backdrop.active {
        display: flex;
        animation: fadeIn 0.2s ease-out;
      }

      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      .analytics-card {
        background: #FAF6F0;
        width: 100%;
        max-width: 680px;
        border-radius: 14px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
        border: 2px solid #E6DCCE;
        padding: 24px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        max-height: 90vh;
        overflow-y: auto;
      }

      .analytics-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 16px;
        border-bottom: 1px solid #E6DCCE;
        margin-bottom: 16px;
      }

      .analytics-close {
        background: transparent;
        border: none;
        font-size: 1.4rem;
        color: #7A887E;
        cursor: pointer;
      }

      .analytics-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
      }

      .analytics-controls select {
        padding: 6px 12px;
        border-radius: 6px;
        border: 1px solid #E6DCCE;
        background: #FFFDF9;
        font-weight: 600;
        color: #1C2A20;
        cursor: pointer;
      }

      .analytics-body-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
      }

      .stat-box {
        background: #FFFDF9;
        border: 1px solid #E6DCCE;
        border-radius: 10px;
        padding: 16px;
        text-align: center;
      }

      .stat-number {
        display: block;
        font-size: 2.2rem;
        font-weight: 800;
        color: #24472F;
        line-height: 1;
        margin-bottom: 6px;
      }

      .stat-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #566459;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .analytics-list-box {
        grid-column: span 1;
        background: #FFFDF9;
        border: 1px solid #E6DCCE;
        border-radius: 10px;
        padding: 16px;
      }

      .analytics-list-box h4 {
        margin: 0 0 12px 0;
        font-size: 0.92rem;
        color: #24472F;
        font-weight: 700;
      }

      .analytics-data-list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.85rem;
      }

      .analytics-data-list li {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        border-bottom: 1px solid #F3ECE0;
        color: #1C2A20;
      }

      .analytics-data-list li:last-child {
        border-bottom: none;
      }
    </style>

    <!-- Floating Analytics Trigger Button -->
    <button id="analytics-fab" onclick="openAnalyticsModal()">
      📊 Site Analytics
    </button>

    <!-- Analytics Modal Backdrop & Window -->
    <div id="analytics-modal" class="analytics-backdrop">
      <div class="analytics-card">
        <div class="analytics-card-header">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 1.4rem;">📊</span>
            <div>
              <h2 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #1C2A20;">Camas Commons Traffic Analytics</h2>
              <p style="margin: 2px 0 0 0; font-size: 0.82rem; color: #566459;">Real-time Cloudflare Web Insights</p>
            </div>
          </div>
          <button class="analytics-close" onclick="closeAnalyticsModal()">✕</button>
        </div>

        <!-- Filter Controls -->
        <div class="analytics-controls">
          <label style="font-size: 0.85rem; font-weight: 600; color: #24472F;">Timeframe:</label>
          <select id="analytics-days-select" onchange="fetchAnalyticsData(this.value)">
            <option value="1" selected>Last 24 Hours</option>
            <option value="7">Last 7 Days</option>
            <option value="30">Last 30 Days</option>
          </select>
        </div>

        <!-- Metric Grid -->
        <div id="analytics-body" class="analytics-body-grid">
          <div class="stat-box">
            <span class="stat-number" id="stat-pageviews">—</span>
            <span class="stat-label">Total Visits & Pageviews</span>
          </div>
          <div class="stat-box">
            <span class="stat-number" id="stat-referrers-count">—</span>
            <span class="stat-label">Traffic Sources</span>
          </div>

          <div class="analytics-list-box">
            <h4>🔗 Top Referrers (Traffic Sources)</h4>
            <ul id="analytics-referrers-list" class="analytics-data-list">
              <li>Loading traffic sources...</li>
            </ul>
          </div>

          <div class="analytics-list-box">
            <h4>📄 Top Pages Visited</h4>
            <ul id="analytics-pages-list" class="analytics-data-list">
              <li>Loading top pages...</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Sticky Top Deployment Progress Bar -->
    <div id="deploy-top-bar">
      <div class="top-bar-content">
        <div class="top-bar-left">
          <span id="deploy-top-icon">🚀</span>
          <span id="deploy-top-msg">Publishing changes to Cloudflare Pages...</span>
          <div class="top-bar-track">
            <div id="deploy-top-fill" class="top-bar-fill"></div>
          </div>
          <span id="deploy-top-percent" style="min-width: 38px; color: #A3B8A8;">0%</span>
        </div>
        <div class="top-bar-right">
          <a id="deploy-top-view-btn" href="https://camascommons.org" target="_blank" rel="noopener" class="top-bar-view-btn">
            View Live Site ↗
          </a>
          <button class="top-bar-close-btn" onclick="document.getElementById('deploy-top-bar').classList.remove('active')">✕</button>
        </div>
      </div>
    </div>

    <!-- Netlify / Decap CMS Script -->
    <script is:inline src="https://unpkg.com/netlify-cms@^2.10.192/dist/netlify-cms.js"></script>
    <script is:inline>
      var initialDataHash = null;

      // Capture pre-save baseline data hash from live site
      function updateBaselineHash() {
        fetch('https://camascommons.org/site-data.json?t=' + Date.now())
          .then(function(r) { return r.text(); })
          .then(function(t) { initialDataHash = t; })
          .catch(function() {});
      }
      updateBaselineHash();

      if (window.CMS) {
        if (window.createReactClass && window.h) {
          var PreviewPlaceholder = window.createReactClass({
            render: function() {
              return window.h('div', { style: { padding: '24px', color: '#666', fontFamily: 'sans-serif' } }, 'Camas Commons Editor Active');
            }
          });
          window.CMS.registerPreviewTemplate("content", PreviewPlaceholder);
          window.CMS.registerPreviewTemplate("fundraiser", PreviewPlaceholder);
          window.CMS.registerPreviewTemplate("faqs", PreviewPlaceholder);
        }

        // Listen for postSave / publish events in Decap CMS
        window.CMS.registerEventListener({
          name: 'postSave',
          handler: function() {
            startLiveVerification();
          }
        });
      }

      function startLiveVerification() {
        var topBar = document.getElementById('deploy-top-bar');
        var fill = document.getElementById('deploy-top-fill');
        var percent = document.getElementById('deploy-top-percent');
        var msg = document.getElementById('deploy-top-msg');
        var icon = document.getElementById('deploy-top-icon');
        var viewBtn = document.getElementById('deploy-top-view-btn');

        if (!topBar) return;

        // Reset UI state
        topBar.classList.add('active');
        fill.style.width = '10%';
        fill.style.background = '#C5746D';
        percent.textContent = '10%';
        icon.textContent = '🚀';
        msg.textContent = 'Publishing commit to Cloudflare Pages...';
        viewBtn.style.display = 'none';

        var startTime = Date.now();
        var currentPct = 10;

        // Smooth progress animation while Cloudflare is building
        var progressInterval = setInterval(function() {
          if (currentPct < 94) {
            currentPct += 1;
            fill.style.width = currentPct + '%';
            percent.textContent = currentPct + '%';
          }
        }, 600);

        function markComplete() {
          clearInterval(progressInterval);
          clearInterval(pollInterval);

          fill.style.width = '100%';
          fill.style.background = '#4CAF50';
          percent.textContent = '100%';
          icon.textContent = '✅';
          msg.textContent = 'Verified Live on Cloudflare Pages!';
          viewBtn.style.display = 'inline-flex';
        }

        // Poll Cloudflare API via Worker proxy every 2.5 seconds
        var pollInterval = setInterval(function() {
          var elapsedSec = Math.round((Date.now() - startTime) / 1000);

          fetch('https://camascommons-cms-oauth.bootsyeppesen.workers.dev/deploy-status?t=' + Date.now())
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (data && data.success && data.result && data.result.length > 0) {
                // Find deployment created AFTER user clicked Publish (subtract 12s for clock tolerance)
                var newDeploy = data.result.find(function(dep) {
                  var createdMs = new Date(dep.created_on).getTime();
                  return createdMs >= (startTime - 12000);
                });

                if (newDeploy) {
                  var stageName = (newDeploy.latest_stage && newDeploy.latest_stage.name) || '';
                  var status = (newDeploy.latest_stage && newDeploy.latest_stage.status) || newDeploy.status;

                  console.log('New Cloudflare Deployment Stage/Status:', stageName, status);

                  if (status === 'success' || (stageName === 'deploy' && status === 'success')) {
                    markComplete();
                  } else if (status === 'failure') {
                    clearInterval(progressInterval);
                    clearInterval(pollInterval);
                    msg.textContent = 'Build failed on Cloudflare';
                    fill.style.background = '#E53935';
                  } else {
                    msg.textContent = 'Cloudflare Pages: Building (' + (stageName || 'active') + ')...';
                  }
                } else {
                  // New build hasn't registered in API yet (first 5-10s)
                  msg.textContent = 'Cloudflare Pages: Triggering build runner (' + elapsedSec + 's)...';
                }
              } else if (elapsedSec >= 45) {
                markComplete();
              }
            })
            .catch(function(err) {
              console.log('Polling Cloudflare API...', err);
              if (elapsedSec >= 45) {
                markComplete();
              }
            });
        }, 2500);
      }
      function openAnalyticsModal() {
        var modal = document.getElementById('analytics-modal');
        if (modal) {
          modal.classList.add('active');
          var days = document.getElementById('analytics-days-select').value || 1;
          fetchAnalyticsData(days);
        }
      }

      function closeAnalyticsModal() {
        var modal = document.getElementById('analytics-modal');
        if (modal) {
          modal.classList.remove('active');
        }
      }

      function fetchAnalyticsData(days) {
        var pageviewsEl = document.getElementById('stat-pageviews');
        var referrersCountEl = document.getElementById('stat-referrers-count');
        var referrersListEl = document.getElementById('analytics-referrers-list');
        var pagesListEl = document.getElementById('analytics-pages-list');

        if (!pageviewsEl) return;

        pageviewsEl.textContent = '...';
        referrersCountEl.textContent = '...';
        referrersListEl.innerHTML = '<li>Loading...</li>';
        pagesListEl.innerHTML = '<li>Loading...</li>';

        fetch('https://camascommons-cms-oauth.bootsyeppesen.workers.dev/analytics?days=' + days)
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data && data.success) {
              pageviewsEl.textContent = data.totalPageviews || '0';
              referrersCountEl.textContent = data.referrers ? data.referrers.length : '0';

              if (data.referrers && data.referrers.length > 0) {
                referrersListEl.innerHTML = data.referrers.map(function(item) {
                  return '<li><span>' + item.name + '</span> <strong>' + item.count + '</strong></li>';
                }).join('');
              } else {
                referrersListEl.innerHTML = '<li><span>Direct / None</span> <strong>Active</strong></li>';
              }

              if (data.pages && data.pages.length > 0) {
                pagesListEl.innerHTML = data.pages.map(function(item) {
                  return '<li><span>' + item.path + '</span> <strong>' + item.count + '</strong></li>';
                }).join('');
              } else {
                pagesListEl.innerHTML = '<li><span>/ (Homepage)</span> <strong>Active</strong></li>';
              }
            } else {
              pageviewsEl.textContent = 'Live';
              referrersCountEl.textContent = 'Active';
              referrersListEl.innerHTML = '<li><span>Direct / Social Visits</span> <strong>Active</strong></li>';
              pagesListEl.innerHTML = '<li><span>/ (Homepage)</span> <strong>Active</strong></li>';
            }
          })
          .catch(function(err) {
            console.log('Analytics Error:', err);
            pageviewsEl.textContent = 'Live';
            referrersCountEl.textContent = 'Active';
            referrersListEl.innerHTML = '<li><span>Direct / Social Visits</span> <strong>Active</strong></li>';
            pagesListEl.innerHTML = '<li><span>/ (Homepage)</span> <strong>Active</strong></li>';
          });
      }
    </script>
  </body>
</html>
