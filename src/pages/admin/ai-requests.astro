      function escapeHtml(str) {
        return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function cleanDescription(desc) {
        if (!desc) return '';
        return desc.replace(/## 🤖 Client Change Request[\s\S]*?### 📝 Request Details:\s*/, '').replace(/\*Note: Execute this task[\s\S]*/, '').trim();
      }

      function handleRequestSubmit(e) {
        e.preventDefault();
        var token = getUserToken();
        var form = document.getElementById('ai-request-form');
        var submitBtn = document.getElementById('submit-btn');
        var statusEl = document.getElementById('form-status');

        if (!token) {
          statusEl.style.color = '#C5746D';
          statusEl.textContent = 'Authentication error: Please log into the CMS to submit requests.';
          return;
        }

        var formData = new FormData(form);
        var payload = Object.fromEntries(formData.entries());

        submitBtn.disabled = true;
        statusEl.style.color = '#566459';
        statusEl.textContent = 'Submitting request to AI agent...';

        fetch('/api/request-change', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token
          },
          body: JSON.stringify(payload)
        })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            submitBtn.disabled = false;
            if (data && data.success) {
              statusEl.style.color = '#24472F';
              statusEl.textContent = 'Request submitted successfully! Task issue #' + (data.issueNumber || '') + ' created.';
              form.reset();
              setTimeout(loadRequests, 1000);
            } else {
              statusEl.style.color = '#C5746D';
              statusEl.textContent = 'Error: ' + (data.error || 'Failed to submit request.');
            }
          })
          .catch(function(err) {
            submitBtn.disabled = false;
            statusEl.style.color = '#C5746D';
            statusEl.textContent = 'Connection error. Please try again.';
          });
      }

