    <script is:inline>
      function getUserToken() {
        try {
          var user = localStorage.getItem('netlify-cms-user') || localStorage.getItem('decap-cms-user');
          if (user) {
            var userData = JSON.parse(user);
            if (userData && userData.token) return userData.token;
            if (userData && userData.user && userData.user.token) return userData.user.token;
          }
        } catch (e) {}
        return null;
      }

      function loadRequests() {
        var token = getUserToken();
        var loadingEl = document.getElementById('requests-loading');
        var emptyEl = document.getElementById('requests-empty');
        var containerEl = document.getElementById('requests-container');

        if (!token) {
          loadingEl.textContent = 'Please log into the CMS to view requests.';
          return;
        }

        loadingEl.style.display = 'block';
        emptyEl.style.display = 'none';
        containerEl.style.display = 'none';

        fetch('/api/list-requests', {
          headers: { 'Authorization': 'Bearer ' + token }
        })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            loadingEl.style.display = 'none';

            if (data && data.success && data.requests && data.requests.length > 0) {
              containerEl.style.display = 'flex';
              containerEl.innerHTML = data.requests.map(renderRequestCard).join('');
            } else {
              emptyEl.style.display = 'block';
            }
          })
          .catch(function(err) {
            console.error('Error loading requests:', err);
            loadingEl.textContent = 'Failed to load change requests.';
          });
      }

