---
import Button from '../../components/Button.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Agent Requests - Camas Commons Admin</title>
  </head>
  <body>
    <div class="admin-app">
      <!-- Admin Top Navigation Header -->
      <header class="admin-header">
        <div class="admin-header-inner">
          <div class="brand-title">Camas Commons Admin</div>
          <nav class="admin-nav">
            <a href="/admin" class="nav-link">Content CMS</a>
            <a href="/admin/ai-requests" class="nav-link active">AI Agent Requests</a>
            <a href="https://dev.camascommons.org" target="_blank" rel="noopener" class="nav-link staging-link">Staging Site</a>
            <a href="https://camascommons.org" target="_blank" rel="noopener" class="nav-link live-link">Live Site</a>
          </nav>
        </div>
      </header>

      <main class="admin-main">
        <div class="container">
          <!-- Page Header -->
          <div class="page-title-box">
            <h1 class="page-title">AI Agent Change Requests</h1>
            <p class="page-subtitle">Submit non-CMS code change requests to the AI agent, preview builds on staging, and approve changes to production.</p>
          </div>

          <!-- Section 1: Submit Request Form -->
          <section class="admin-card margin-bottom">
            <div class="card-header">
              <h2 class="card-title">Submit New Request</h2>
              <p class="card-subtitle">Changes will be built and previewed automatically on dev.camascommons.org</p>
            </div>

            <form id="ai-request-form" onsubmit="handleRequestSubmit(event)">
              <div style="display:none;" aria-hidden="true">
                <input type="text" name="website_url" tabindex="-1" autocomplete="off" />
              </div>

              <div class="form-grid-2">
                <div class="form-group">
                  <label for="req-name">Your Name</label>
                  <input type="text" id="req-name" name="clientName" placeholder="e.g. Ally or Guise" required />
                </div>
                <div class="form-group">
                  <label for="req-email">Your Email</label>
                  <input type="email" id="req-email" name="clientEmail" placeholder="e.g. ally@camascommons.org" required />
                </div>
              </div>

              <div class="form-group">
                <label for="req-target">Target Page / Section</label>
                <select id="req-target" name="affectedPage">
                  <option value="Homepage / Main">Homepage / Main Site</option>
                  <option value="Header & Navbar">Header & Navigation Menu</option>
                  <option value="Footer">Footer & Social Links</option>
                  <option value="FAQs Section">FAQs & Questions</option>
                  <option value="Fundraiser Tracker">Fundraiser Tracker / Thermometer</option>
                  <option value="New Page / Layout">New Custom Page or Layout</option>
                </select>
              </div>

              <div class="form-group">
                <label for="req-title">Summary / Request Title</label>
                <input type="text" id="req-title" name="requestTitle" placeholder="e.g. Add newsletter signup block to footer" required />
              </div>

              <div class="form-group">
                <label for="req-desc">Detailed Description</label>
                <textarea id="req-desc" name="requestDescription" placeholder="Describe the exact changes, text, colors, or new elements you want the AI agent to build..." required></textarea>
              </div>

              <div class="form-actions">
                <Button type="submit" id="submit-btn" variant="green" size="md">
                  Submit Request to AI Agent
                </Button>
              </div>
              <div id="form-status" class="form-status-msg"></div>
            </form>
          </section>

          <!-- Section 2: Request History & Management Table -->
          <section class="admin-card">
            <div class="card-header flex-between">
              <div>
                <h2 class="card-title">Request Status & Approvals</h2>
                <p class="card-subtitle">Review changes built by the AI agent on staging before merging to production.</p>
              </div>
              <button onclick="loadRequests()" class="btn-refresh">Refresh List</button>
            </div>

            <div id="requests-loading" class="state-loading">Loading requests...</div>
            <div id="requests-empty" class="state-empty" style="display:none;">No AI agent change requests found.</div>

            <div id="requests-container" class="requests-list" style="display:none;">
              <!-- Dynamic request cards populated via JS -->
            </div>
          </section>
        </div>
      </main>
    </div>

    <style is:global>
      :root {
        --color-green-deep: #24472F;
        --color-green-light: #EBF3ED;
        --color-green-hover: #193321;
        --color-rose-terracotta: #C5746D;
        --color-rose-light: #F8ECEB;
        --color-bg-paper: #FAF6F0;
        --color-card-paper: #FFFDF9;
        --color-border-paper: #E6DCCE;
        --color-text-ink: #1C2A20;
        --color-text-muted: #566459;
        --font-serif: "Fraunces", Georgia, serif;
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
