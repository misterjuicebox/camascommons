---
interface Props {
  label: string;
  src?: string;
  height?: string;
  caption?: string;
  clickable?: boolean;
}

const { label, src, height = '340px', caption, clickable = false } = Astro.props;

// Extract base name from label or src (e.g. "/images/hay.jpeg" -> "hay.jpeg")
const initialPath = src || label.replace(/\[(PHOTO|IMAGE):\s*/i, '').replace(/\]/, '').trim();
const rawFilename = initialPath.replace(/^\/?(images\/)+/, '');
const baseNameWithoutExt = rawFilename.replace(/\.[^/.]+$/, '').trim();

// Query files in public/images at build time via Vite globbing (compatible everywhere)
const imageModules = import.meta.glob('/public/images/*');
const filenames = Object.keys(imageModules).map((p) => p.replace('/public/images/', ''));

// Candidate filenames to look for in public/images
const candidateNames = [
  rawFilename,
  `${baseNameWithoutExt}.jpeg`,
  `${baseNameWithoutExt}.jpg`,
  `${baseNameWithoutExt}.png`,
  `${baseNameWithoutExt.replace(/\s+/g, '')}.jpeg`,
  `${baseNameWithoutExt.replace(/\s+/g, '')}.jpg`,
  `${baseNameWithoutExt.replace(/\s+/g, '')}.png`
];

let matchedFilename = '';
for (const candidate of candidateNames) {
  const found = filenames.find((f) => f.toLowerCase() === candidate.toLowerCase());
  if (found) {
    matchedFilename = found;
    break;
  }
}

const fileExists = Boolean(matchedFilename);
const relativeImagePath = `/images/${matchedFilename}`;
---

<figure class={`field-photo-frame ${clickable && fileExists ? 'is-clickable' : ''}`} style={`min-height: ${fileExists ? 'auto' : height};`}>
  {fileExists ? (
    <div class="photo-real-wrapper" data-zoom-src={clickable ? relativeImagePath : undefined}>
      <img src={relativeImagePath} alt={label} class="real-photo-img" loading="lazy" />
      {clickable && (
        <span class="zoom-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          Click to enlarge
        </span>
      )}
      {caption && <figcaption class="photo-caption-text">{caption}</figcaption>}
    </div>
  ) : (
    <div class="photo-inner">
      <div class="photo-badge">FIELD PHOTO PLACEHOLDER</div>
      <span class="photo-label">{label}</span>
      <span class="photo-path-hint">Put image file in <code>public/images/{rawFilename}</code></span>
    </div>
  )}
</figure>

<script is:inline>
  if (!window.__lightboxScriptInitialized) {
    window.__lightboxScriptInitialized = true;
    document.addEventListener('click', (e) => {
      const target = e.target.closest('[data-zoom-src]');
      if (!target) return;
      const src = target.getAttribute('data-zoom-src');
      if (!src) return;

      let modal = document.getElementById('global-lightbox-modal');
      if (!modal) {
        modal = document.createElement('dialog');
        modal.id = 'global-lightbox-modal';
        modal.className = 'lightbox-dialog';
        modal.innerHTML = `
          <div class="lightbox-wrapper">
            <button class="lightbox-close-btn" aria-label="Close image">&times;</button>
            <img class="lightbox-modal-img" src="" alt="Enlarged full size view" />
          </div>
        `;
        document.body.appendChild(modal);

        modal.addEventListener('click', (evt) => {
          if (evt.target === modal || evt.target.classList.contains('lightbox-close-btn') || evt.target.classList.contains('lightbox-wrapper')) {
            modal.close();
          }
        });
      }

      const img = modal.querySelector('.lightbox-modal-img');
      if (img) img.src = src;
      modal.showModal();
    });
  }
</script>

<style>
  .field-photo-frame {
    width: 100%;
    background: var(--color-card-paper);
    border: 1px solid var(--color-border-paper);
    border-radius: var(--radius-paper);
    padding: 1rem;
    margin: 2rem 0;
    box-shadow: var(--shadow-paper);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .field-photo-frame.is-clickable {
    cursor: pointer;
  }

  .field-photo-frame:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(36, 71, 47, 0.09);
    border-color: var(--color-rose-border);
  }

  /* Tape accent */
  .field-photo-frame::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 40px;
    width: 70px;
    height: 18px;
    background: rgba(224, 211, 193, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.4);
    transform: rotate(-2deg);
    z-index: 2;
  }

  .photo-real-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .real-photo-img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid var(--color-border-subtle);
  }

  .zoom-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(36, 71, 47, 0.85);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 6px;
    backdrop-filter: blur(4px);
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .photo-real-wrapper:hover .zoom-badge {
    opacity: 1;
    transform: scale(1.04);
  }

  .photo-inner {
    width: 100%;
    height: 100%;
    background: var(--color-bg-subtle);
    border: 1px dashed var(--color-border-subtle);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.5rem;
    text-align: center;
    gap: 0.5rem;
  }

  .photo-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-text-soft);
    text-transform: uppercase;
  }

  .photo-label {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-rose-terracotta);
    letter-spacing: 0.02em;
  }

  .photo-path-hint {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .photo-path-hint code {
    background: rgba(255, 255, 255, 0.6);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    color: var(--color-green-deep);
  }

  .photo-caption-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: 0.75rem;
  }
</style>
